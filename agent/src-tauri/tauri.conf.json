{
  "$schema": "https://raw.githubusercontent.com/niceda/tauri/dev/packages/tauri-config-schema/schema.json",
  "productName": "BDOI Vanguard",
  "version": "0.1.0",
  "identifier": "com.bdoi.vanguard",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "title": "BDOI Vanguard",
    "windows": [
      {
        "title": "BDOI Vanguard - Anti-Cheat Monitor",
        "width": 400,
        "height": 300,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
